+fn large_context_still_rejects_oversized_state_and_action_atomically() {
+    for mode in [ProtocolMode::Paper, ProtocolMode::V2, ProtocolMode::V3] {
+        for oversized_state in [true, false] {
+            let mut runtime = RuntimeState::default();
+            let mut step = request(0, "exec_command");
+            step.mode = mode;
+            step.state_revision = (mode != ProtocolMode::Paper).then_some(0);
+            step.comment = None;
+            if oversized_state {
+                step.state_patch = serde_json::json!({"facts": ["s".repeat(2 * 1024 * 1024)]});
+            } else {
