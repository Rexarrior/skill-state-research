@@ -0,0 +1,29 @@
+use codex_history::CodexHarnessMetadata;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::ResponseItem;
+use codex_utils_output_truncation::approx_tokens_from_byte_count;
+
+/// Each field is already bounded by SKILL.state. A second text truncation of
+/// this JSON container would corrupt the next snapshot (including on resume).
+/// This allowance is history metadata, not additional provider-visible text.
+pub(crate) fn history_envelope(item: ResponseItem) -> ResponseItemEnvelope {
+    let metadata = match &item {
+        ResponseItem::FunctionCallOutput { name, output, .. }
+            if name.as_deref() == Some(super::TOOL_NAME) =>
+        {
+            match &output.body {
+                FunctionCallOutputBody::Text(text) => Some(CodexHarnessMetadata {
+                    fallback_token_limit_override: Some(
+                        usize::try_from(approx_tokens_from_byte_count(text.len()))
+                            .unwrap_or(usize::MAX),
+                    ),
+                    ..Default::default()
+                }),
+                _ => None,
+            }
+        }
+        _ => None,
+    };
+    ResponseItemEnvelope { item, metadata }
+}
