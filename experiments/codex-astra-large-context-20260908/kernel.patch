+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn exec_large_context_preserves_state_and_validation_feedback_on_wire() -> anyhow::Result<()>
+{
+    for mode in ["paper", "v2", "v3"] {
+        let test = test_codex_exec();
+        let server = start_mock_server().await;
+        let fact = format!("{}state-tail-marker", "s".repeat(64 * 1024));
+        let invalid_tool = format!("{}feedback-tail-marker", "x".repeat(20 * 1024));
+        let actions = [
+            json!({"name": "exec_command", "input": {"cmd": "pwd"}}),
+            json!({"name": invalid_tool, "input": {}}),
+            json!({"name": "finish", "input": {"message": "Large feedback fixture complete."}}),
+        ];
+        let mut responses = Vec::new();
+        for (index, action) in actions.into_iter().enumerate() {
+            let mut step = json!({"state_patch": {}});
+            if index == 0 {
+                step["state_patch"] = json!({"facts": [fact]});
+            }
+            if mode != "paper" {
+                step["state_revision"] = json!(index.min(1));
+            }
+            if mode == "v3" {
+                step["actions"] = json!([action]);
+            } else {
+                step["action"] = action;
+            }
+            let id = format!("large-feedback-{index}");
+            responses.push(sse(vec![
+                ev_response_created(&id),
+                ev_function_call(&format!("call-{id}"), "skill_step", &step.to_string()),
+                ev_completed(&id),
+            ]));
+        }
+        let mock = mount_sse_sequence(&server, responses).await;
+        let output = test
+            .cmd_with_server(&server)
+            .env("CODEX_SKILL_STATE_MODE", mode)
+            .arg("--skip-git-repo-check")
+            .arg("Exercise large state and validation feedback")
+            .output()?;
+        assert!(output.status.success(), "{mode}: {:?}", output.status);
+        let requests = mock.requests();
+        assert_eq!(requests.len(), 3);
+        for request in &requests[1..] {
+            let groups = request.message_input_text_groups("user");
+            assert_eq!(groups.len(), 1);
+            assert!(groups[0].join("\n").contains(&fact));
+        }
+        let prompt = requests[2].message_input_text_groups("user")[0].join("\n");
+        assert!(
+            prompt.contains(&invalid_tool),
+            "{mode}: large feedback was truncated"
+        );
+        assert!(prompt.contains("is not available in this step's tool plan"));
+        assert!(!prompt.contains("[truncated by SKILL.state]"));
+        assert!(
+            String::from_utf8_lossy(&output.stdout).contains("Large feedback fixture complete.")
+        );
+    }
+    Ok(())
+}
