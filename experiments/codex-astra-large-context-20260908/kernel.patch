+#[test]
+fn large_context_retains_state_input_and_result_through_history_and_prompt() {
+    use crate::context_manager::ContextManager;
+    use codex_utils_output_truncation::TruncationPolicy;
+    for mode in [ProtocolMode::Paper, ProtocolMode::V2, ProtocolMode::V3] {
+        let mut runtime = RuntimeState::default();
+        let fact = format!("{}state-tail", "ф".repeat(48 * 1024));
+        let command = format!("{}input-tail", "i".repeat(128 * 1024));
+        let result = format!("{}result-tail", "я".repeat(128 * 1024));
+        let accepted = runtime
+            .accept(
+                Snapshot::default(),
+                StepRequest {
+                    mode,
+                    state_revision: (mode != ProtocolMode::Paper).then_some(0),
+                    state_patch: serde_json::json!({"facts": [fact]}),
+                    comment: None,
+                    actions: vec![RequestedAction {
+                        name: "exec_command".to_string(),
+                        input: serde_json::json!({"command": command}),
+                    }],
+                },
+                &[function_tool("exec_command")],
+            )
+            .unwrap();
+        let output = transition_output(
+            "large".to_string(),
+            accepted,
+            vec![ActionOutcome {
+                status: BatchActionStatus::Success,
+                result: result.clone(),
+            }],
+        );
+        let envelope = history_envelope(output.clone());
+        let mut history = ContextManager::new();
+        history.record_annotated_items(&[envelope.clone()], TruncationPolicy::Tokens(100));
+        let retained = history.raw_items().cloned().collect::<Vec<_>>();
+        assert_eq!(retained, vec![output]);
+        let restored = snapshot(&retained, mode);
+        assert_eq!(restored.revision, 1);
+        assert_eq!(restored.state.facts, vec![fact.clone()]);
+        match &restored.observations[0] {
+            Observation::Single(o) => {
+                assert_eq!(o.input, serde_json::json!({"command": command}));
+                assert_eq!(o.result, result);
+            }
+            Observation::Batch(o) => {
+                assert_eq!(o.actions[0].input, serde_json::json!({"command": command}));
+                assert_eq!(o.actions[0].result, result);
+            }
+        }
+        let visible = serde_json::to_string(&provider_input(&retained, mode)).unwrap();
+        assert!(visible.contains("state-tail"));
+        assert!(visible.contains("result-tail"));
+        assert_eq!(visible.contains("input-tail"), mode != ProtocolMode::Paper);
+        let restored_metadata: codex_history::CodexHarnessMetadata =
+            serde_json::from_str(&serde_json::to_string(&envelope.metadata.unwrap()).unwrap())
+                .unwrap();
+        let mut resumed = ContextManager::new();
+        resumed.record_annotated_items(
+            &[codex_history::ResponseItemEnvelope {
+                item: retained[0].clone(),
+                metadata: Some(restored_metadata),
+            }],
+            TruncationPolicy::Tokens(100),
+        );
+        assert_eq!(resumed.raw_items().cloned().collect::<Vec<_>>(), retained);
+    }
+}
