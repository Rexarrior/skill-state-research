+async fn exec_large_context_preserves_state_and_observation_on_wire() -> anyhow::Result<()> {
+    for mode in ["paper", "v2", "v3"] {
+        let test = test_codex_exec();
+        let server = start_mock_server().await;
+        let fact = format!("{}state-tail-marker", "s".repeat(64 * 1024));
+        let result = format!("{}result-tail-marker", "r".repeat(20 * 1024));
+        std::fs::write(test.cwd_path().join("large-observation.txt"), &result)?;
+        let action = json!({"name": "exec_command", "input": {
+            "cmd": "cat large-observation.txt",
+            "max_output_tokens": 20000,
+            "yield_time_ms": 1000
+        }});
+        let mut first = json!({"state_patch": {"facts": [fact]}});
+        let mut finish = json!({"state_patch": {}});
+        let finish_action =
+            json!({"name": "finish", "input": {"message": "Large context fixture complete."}});
+        if mode != "paper" {
+            first["state_revision"] = json!(0);
+            finish["state_revision"] = json!(1);
+        }
+        if mode == "v3" {
+            first["actions"] = json!([action]);
+            finish["actions"] = json!([finish_action]);
+        } else {
+            first["action"] = action;
+            finish["action"] = finish_action;
+        }
+        let mock = mount_sse_sequence(
+            &server,
+            vec![
+                sse(vec![
+                    ev_response_created("large-1"),
+                    ev_function_call("large-call-1", "skill_step", &first.to_string()),
+                    ev_completed("large-1"),
+                ]),
+                sse(vec![
+                    ev_response_created("large-2"),
+                    ev_function_call("large-call-2", "skill_step", &finish.to_string()),
+                    ev_completed("large-2"),
+                ]),
+            ],
+        )
+        .await;
+        let output = test
+            .cmd_with_server(&server)
+            .env("CODEX_SKILL_STATE_MODE", mode)
