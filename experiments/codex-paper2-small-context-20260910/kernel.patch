+                    ev_function_call("large-call-1", "skill_step", &first.to_string()),
+                    ev_completed("large-1"),
+                ]),
+                sse(vec![
+                    ev_response_created("large-2"),
+                    ev_function_call("large-call-2", "skill_step", &finish.to_string()),
+                    ev_completed("large-2"),
+                ]),
+            ],
+        )
+        .await;
+        let output = test
+            .cmd_with_server(&server)
+            .env("CODEX_SKILL_STATE_MODE", mode)
+            .arg("--skip-git-repo-check")
+            .arg("-s")
+            .arg("danger-full-access")
+            .arg("Exercise the large-context fixture")
+            .output()?;
+        assert!(output.status.success(), "{mode}: {:?}", output.status);
+        let requests = mock.requests();
+        assert_eq!(requests.len(), 2);
+        let groups = requests[1].message_input_text_groups("user");
+        assert_eq!(groups.len(), 1);
+        let prompt = groups[0].join("\n");
