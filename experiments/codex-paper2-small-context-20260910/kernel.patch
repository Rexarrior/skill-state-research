+++ b/codex/codex-rs/core/src/skill_state_paper2.rs
@@ -0,0 +1,20 @@
+use super::Observation;
+use super::Snapshot;
+use super::paper;
+
+// Keep Paper's prompt and schema unchanged; only the environment observation
+// gains the identity of its action. Never expose revision, comment, or older O.
+pub(super) fn prompt(task: &str, snapshot: &Snapshot) -> String {
+    let observation = snapshot.observations.last().and_then(|value| match value {
+        Observation::Single(value) => Some(
+            serde_json::json!({
+                "action": { "name": value.action, "input": value.input },
+                "status": value.status,
+                "result": value.result,
+            })
+            .to_string(),
+        ),
+        Observation::Batch(_) => None,
+    });
+    paper::prompt(task, &snapshot.state, observation.as_deref())
+}
